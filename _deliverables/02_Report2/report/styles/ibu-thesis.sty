\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/ibu-thesis}[2026/05/11 Minimal IBU thesis compatibility style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{geometry}
\RequirePackage{setspace}

\geometry{a4paper, margin=2.5cm}
\onehalfspacing

\makeatletter

\newcommand{\ibu@thesistitle}{}
\newcommand{\ibu@faculty}{}
\newcommand{\ibu@degree}{}
\newcommand{\ibu@department}{}
\newcommand{\ibu@submissiondate}{}
\newcommand{\ibu@abstract}{}

\newcommand{\thesistitle}[1]{\gdef\ibu@thesistitle{#1}}
\newcommand{\authors}[2][]{\expandafter\gdef\csname ibu@author@#1\endcsname{#2}}
\newcommand{\authorsid}[2][]{\expandafter\gdef\csname ibu@authorid@#1\endcsname{#2}}
\newcommand{\supervisors}[2][]{\expandafter\gdef\csname ibu@supervisor@#1\endcsname{#2}}
\newcommand{\faculty}[1]{\gdef\ibu@faculty{#1}}
\newcommand{\degree}[1]{\gdef\ibu@degree{#1}}
\newcommand{\department}[1]{\gdef\ibu@department{#1}}
\newcommand{\submissiondate}[1]{\gdef\ibu@submissiondate{#1}}
\renewcommand{\abstract}[1]{\gdef\ibu@abstract{#1}}

\newcommand{\ibu@printauthor}[1]{%
  \@ifundefined{ibu@author@#1}{}{%
    \csname ibu@author@#1\endcsname%
    \@ifundefined{ibu@authorid@#1}{}{, \csname ibu@authorid@#1\endcsname}%
    \par}}

\newcommand{\ibu@printsupervisor}[1]{%
  \@ifundefined{ibu@supervisor@#1}{}{\csname ibu@supervisor@#1\endcsname\par}}

\renewcommand{\maketitle}{%
  \begin{titlepage}
    \centering
    \vspace*{1cm}
    {\Large\bfseries \ibu@thesistitle\par}
    \vspace{1.5cm}
    {\large by\par}
    \vspace{0.5cm}
    {\large
      \ibu@printauthor{1}
      \ibu@printauthor{2}
      \ibu@printauthor{3}
      \ibu@printauthor{4}
      \ibu@printauthor{5}
    }
    \vspace{1.5cm}
    {\large Supervised by\par}
    \vspace{0.5cm}
    {\large
      \ibu@printsupervisor{1}
      \ibu@printsupervisor{2}
      \ibu@printsupervisor{3}
    }
    \vfill
    Submitted to the\par
    \ibu@faculty\par
    in partial fulfillment of the requirements for the\par
    \ibu@degree\par
    in the\par
    \ibu@department\par
    \vspace{1.2cm}
    \ibu@submissiondate\par
  \end{titlepage}}

\newcommand{\makeabstract}{%
  \section*{\abstractname}
  \ibu@abstract
  \clearpage}

\newcommand{\maketableofcontents}{%
  \tableofcontents
  \clearpage}

\newcommand{\listofabbrv}{List of Abbreviations}
\newcommand{\makelistofabbrv}{\section*{\listofabbrv}}
\newcommand{\listofsymbols}{List of Symbols}
\newcommand{\makelistofsymbols}{\section*{\listofsymbols}}
\newcommand{\makelistoffigures}{\listoffigures\clearpage}
\newcommand{\makelistoftables}{\listoftables\clearpage}

\newenvironment{abbrv}{\begin{description}}{\end{description}}
\newenvironment{symbols}{\begin{description}}{\end{description}}

\makeatother
